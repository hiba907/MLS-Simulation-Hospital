# =============================================================================
# API Keys for Reasoning Canvas + Virtual Patient (LLM-backed)
# =============================================================================
# Copy this file to `.env` and fill in the keys you want to use.
# The pipeline auto-detects which one is set.
#
# Quickest start: get a free OpenRouter key at https://openrouter.ai/keys
# and set OPENROUTER_API_KEY below.
# =============================================================================

# ── OpenRouter (recommended, has a free tier) ─────────────────────
# Sign up: https://openrouter.ai/keys
# Free models:  meta-llama/llama-3.3-70b-instruct:free
#               google/gemini-2.0-flash-exp:free
#               qwen/qwen-2.5-72b-instruct:free
# Paid (better): anthropic/claude-sonnet-4.5  (~$3/1M, best for clinical)
#                openai/gpt-4o-mini           (~$0.15/1M, very cheap)
#                openai/gpt-4o                (~$2.50/1M, best)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── OpenAI direct ─────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ── Anthropic direct ──────────────────────────────────────────────
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (no key needed, just install + ollama serve) ───────────
# https://ollama.com
# curl -fsSL https://ollama.com/install.sh | sh
# ollama pull llama3.1:8b
# ollama serve
